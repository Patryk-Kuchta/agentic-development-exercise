{
  "$schema": "https://json.schemastore.org/tsconfig",
  "_comment": "Contents of @tsconfig/strictest, copied rather than installed, with stale keys removed and four flags added. See AGENTS.md.",
  "compilerOptions": {
    /* --- from @tsconfig/strictest --- */
    "strict": true,
    "allowUnusedLabels": false,
    "allowUnreachableCode": false,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    /* --- our additions --- */
    /* Was false. Flipped: drizzle-orm 1.0-rc ships .d.ts files that do not
       type-check under strict settings (cockroach-core, column-builder
       variance). None of it is our code, and none of it is reachable from
       our imports. Revisit if drizzle 1.0 final cleans them up. */
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noUncheckedSideEffectImports": true,

    /* --- module system: one setting for every package, so packages/contract
           can be imported as source by both the tsx-run API and the Vite web app --- */
    "target": "ES2023",
    "module": "preserve",
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "noEmit": true
  }
}
